{
  "name": "content-post-api",
  "version": "1.0.0",
  "description": "API da Pauta de Conteúdo: organizações, usuários, marca, ideias, calendário, criação com Claude e Magnific e publicação pelo Ayrshare.",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/servidor.js",
    "dev": "node --watch src/servidor.js",
    "migrar": "node src/migrar.js",
    "importar-airtable": "node scripts/importar-airtable.js",
    "test": "node --test --test-concurrency=1 \"testes/*.test.js\""
  },
  "dependencies": {
    "@fastify/cors": "11.0.1",
    "fastify": "5.4.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.7"
  }
}
