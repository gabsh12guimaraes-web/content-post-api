# Copie para .env só para rodar no seu computador. No Railway, cadastre estas variáveis na aba Variables do serviço.
# Nunca coloque valores reais neste arquivo nem no repositório.

# Postgres. No Railway: ${{Postgres.DATABASE_URL}}. Local sem Postgres: pglite:./dados-locais
DATABASE_URL=

# 32 bytes aleatórios em base64. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Cifra as chaves das integrações. Guarde num gerenciador de senhas: se perder, as chaves precisam ser cadastradas de novo.
CHAVE_MESTRA=

# Pasta dos arquivos. No Railway, crie um Volume montado em /data e use /data/arquivos
PASTA_ARQUIVOS=/data/arquivos

# Sites que podem usar a API (separados por vírgula)
ORIGENS=https://gabsh12guimaraes-web.github.io

# Opcional
# URL_PUBLICA=https://sua-api.up.railway.app   (o Railway preenche sozinho pelo RAILWAY_PUBLIC_DOMAIN)
# CADASTRO_ABERTO=nao                           (só entra quem for convidado)
# MODELO_CLAUDE=claude-opus-5-5

# ---------- Planos e Kiwify ----------
# Liga os limites dos planos (até lá ninguém é bloqueado). Ligue depois de criar os produtos na Kiwify.
COBRANCA=nao
# E-mails de donos cujas organizações não pagam nem têm limite (ex.: a sua), separados por vírgula.
EMAILS_ISENTOS=
# Chaves da plataforma, usadas pelas organizações com plano ativo que não cadastraram chave própria.
# Não existe chave da plataforma para o Zernio: cada organização publica pelo próprio Zernio, com as redes dela.
PLATAFORMA_ANTHROPIC=
PLATAFORMA_MAGNIFIC=
PLATAFORMA_APIFY=
# Nasten: use as chaves de Produção em app.nasten.com.br > Integrações/API.
# Mude para nasten somente após configurar o webhook e conferir o valor final dos cupons.
PAGAMENTOS_PROVEDOR=kiwify
NASTEN_PUBLIC_KEY=
NASTEN_SECRET_KEY=
# signatureSecret do webhook da conta. URL: https://SEU-DOMINIO/nasten
NASTEN_WEBHOOK_SECRET=
# As nove ofertas e a empresa já estão configuradas no código. Sobrescritas opcionais:
NASTEN_CHECKOUT={}
NASTEN_OFERTAS={}
NASTEN_AFILIADOS=https://easycontentpost.com.br/afiliados
# Somente em um ambiente separado de testes, nunca no Railway de produção:
NASTEN_SANDBOX=nao
# Legado: mantenha para receber renovações/estornos de compras antigas em /kiwify.
KIWIFY_TOKEN=
# Opcional: id do produto (ou do plano da assinatura) na Kiwify -> plano:ciclo. Sem isso, vale o nome do produto.
KIWIFY_PRODUTOS={}
